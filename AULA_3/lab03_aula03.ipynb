        'Quero baixar meu holerite',
        'Onde vejo meu contracheque?',
        'Preciso acessar meu contracheque',
        'Como pegar meu comprovante de pagamento?',
        'Onde encontro o comprovante de pagamento?',
        'Quero consultar meu comprovante de rendimentos',

        # =========================
        # ENVIAR ATESTADO
        # =========================
        'Como cadastrar meu atestado medico?',
        'Onde envio o atestado de consulta?',
        'Como enviar meu atestado?',
        'Onde cadastro meu atestado medico?',
        'Preciso enviar um atestado medico',
        'Como faco para cadastrar um atestado?',
        'Onde devo enviar meu atestado?',
        'Quero cadastrar meu atestado',
        'Como encaminhar meu atestado medico?',
        'Onde registro meu atestado?'
    ],

    'intencao': [
        # SOLICITAR FÉRIAS
        'solicitar_ferias',
        'solicitar_ferias',
        'solicitar_ferias',
        'solicitar_ferias',
        'solicitar_ferias',
        'solicitar_ferias',
