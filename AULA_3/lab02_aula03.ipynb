# ============================================================
import pandas as pd
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.naive_bayes import MultinomialNB
from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, confusion_matrix

# Dataset ampliado para avaliação estatística
dados = {
    'mensagem': [
        'Onde fica a loja fisica?',
        'Qual o endereço da unidade SP?',
        'Como chegar na loja?',
        'Onde encontro a loja mais próxima?',
        'Qual é a localização da loja?',
        'Qual o horario de funcionamento?',
        'A loja abre aos domingos?',
        'Que horas voces fecham?',
        'Qual o horário de atendimento?',
        'A loja funciona no sábado?',
        'Quero trocar um produto com defeito',
        'Como funciona a troca?',
        'Preciso devolver meu pedido',
        'Como faço para devolver um produto?',
        'Posso trocar um produto comprado?',
    ],
    'intencao': [
        'localizacao',
        'localizacao',
        'localizacao',
        'localizacao',
        'localizacao',
        'horario_atendimento',
        'horario_atendimento',
        'horario_atendimento',
        'horario_atendimento',
        'horario_atendimento',
        'troca_devolucao',
        'troca_devolucao',
        'troca_devolucao',
        'troca_devolucao',
        'troca_devolucao'
    ]
}

df2 = pd.DataFrame(dados)

X_train, X_test, y_train, y_test = train_test_split(
    df2['mensagem'], df2['intencao'], test_size=0.33, random_state=42, stratify=df2['intencao']
)

vectorizer = TfidfVectorizer(
    ngram_range=(1, 2)
)

X_train_vec = vectorizer.fit_transform(X_train)
X_test_vec = vectorizer.transform(X_test)


modelo = MultinomialNB()
modelo.fit(X_train_vec, y_train)

y_pred = modelo.predict(X_test_vec)

print("--- RESULTADOS DO LAB 02 (AULA 03) ---")

print("\n--- Relatório de Classificação ---")
print(
    classification_report(
        y_test,
        y_pred,
        zero_division=0
    )
)

print("--- Matriz de Confusão ---")
print(confusion_matrix(y_test, y_pred))


print("\n--- Comparação entre valores reais e previstos ---")

resultado = pd.DataFrame({
    'Mensagem': X_test.values,
    'Intenção Real': y_test.values,
    'Intenção Predita': y_pred
})

print(resultado.to_string(index=False))
