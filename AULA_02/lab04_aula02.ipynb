# Importação das bibliotecas

import pandas as pd

from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report


# ============================================================
# 1. CRIAÇÃO DO DATASET
# ============================================================

dados = {
    "frase": [
        # INTENÇÃO: COMPRAR PASSAGEM
        "Quero comprar uma passagem para São Paulo",
        "Preciso reservar um voo para o Rio de Janeiro",
        "Gostaria de comprar uma passagem aérea",
        "Quero viajar para Salvador e preciso de uma passagem",
        "Como faço para comprar uma passagem?",
        
        # INTENÇÃO: CANCELAR RESERVA
        "Quero cancelar minha reserva",
        "Preciso cancelar meu voo",
        "Não vou mais viajar e quero cancelar a passagem",
        "Como posso cancelar minha reserva?",
        "Gostaria de desistir da minha viagem",
        
        # INTENÇÃO: FALAR COM ATENDENTE
        "Quero falar com um atendente",
        "Preciso de ajuda de uma pessoa",
        "Posso falar com um atendente humano?",
        "Quero conversar com alguém da agência",
        "Preciso falar com o suporte"
    ],

    "intencao": [
        # COMPRAR PASSAGEM
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",
        "comprar_passagem",

        # CANCELAR RESERVA
        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",
        "cancelar_reserva",

        # FALAR COM ATENDENTE
        "falar_atendente",
        "falar_atendente",
        "falar_atendente",
        "falar_atendente",
        "falar_atendente"
    ]
}


# ============================================================
# 2. CRIAÇÃO DO DATAFRAME PANDAS
# ============================================================

df = pd.DataFrame(dados)

print("DATASET COMPLETO:")
print(df)

print("\n" + "=" * 50)

print("QUANTIDADE DE FRASES POR INTENÇÃO:")
print(df["intencao"].value_counts())


# ============================================================
# 3. SEPARAÇÃO DAS FEATURES E RÓTULOS
# ============================================================

# X representa as frases
X = df["frase"]

# y representa as intenções
y = df["intencao"]


# ============================================================
# 4. DIVISÃO ENTRE TREINO E TESTE
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.25,
    random_state=42,
    stratify=y
)

print("\n" + "=" * 50)
print("DIVISÃO DOS DADOS")
print("=" * 50)

print("Quantidade de frases para treino:", len(X_train))
print("Quantidade de frases para teste:", len(X_test))


# ============================================================
# 5. VETORIZAÇÃO DOS TEXTOS
# ============================================================

# Criação do vetorizador TF-IDF
vectorizer = TfidfVectorizer()

# O fit_transform aprende o vocabulário e transforma os dados de treino
X_train_vectorizado = vectorizer.fit_transform(X_train)

# O transform apenas transforma os dados de teste
X_test_vectorizado = vectorizer.transform(X_test)


print("\n" + "=" * 50)
print("VETORIZAÇÃO")
print("=" * 50)

print("Formato dos dados de treino:", X_train_vectorizado.shape)
print("Formato dos dados de teste:", X_test_vectorizado.shape)


# ============================================================
# 6. CRIAÇÃO E TREINAMENTO DO MODELO
# ============================================================

modelo = LogisticRegression(max_iter=1000)

# Treinamento do modelo
modelo.fit(X_train_vectorizado, y_train)

print("\n" + "=" * 50)
print("MODELO TREINADO COM SUCESSO!")
print("=" * 50)


# ============================================================
# 7. PREDIÇÕES NO CONJUNTO DE TESTE
# ============================================================

previsoes_teste = modelo.predict(X_test_vectorizado)


print("\n" + "=" * 50)
print("RESULTADOS DO CONJUNTO DE TESTE")
print("=" * 50)

# Mostra frase, intenção real e previsão do modelo
for frase, real, previsto in zip(X_test, y_test, previsoes_teste):
    print("\nFrase:", frase)
    print("Intenção real:", real)
    print("Intenção prevista:", previsto)
    print("-" * 40)


# ============================================================
# 8. CÁLCULO DA ACURÁCIA
# ============================================================

acuracia = accuracy_score(y_test, previsoes_teste)

print("\n" + "=" * 50)
print("ACURÁCIA DO MODELO")
print("=" * 50)

print(f"Acurácia: {acuracia:.2%}")


# ============================================================
# 9. RELATÓRIO DE CLASSIFICAÇÃO
# ============================================================

print("\n" + "=" * 50)
print("RELATÓRIO DE CLASSIFICAÇÃO")
print("=" * 50)

print(
    classification_report(
        y_test,
        previsoes_teste,
        zero_division=0
    )
)

# ============================================================
# 10. PREDIÇÕES COM FRASES INÉDITAS
# ============================================================

# Estas frases NÃO fazem parte do dataset original

novas_frases = [
    "Gostaria de comprar um voo para Recife",
    "Preciso desistir da reserva da minha viagem",
    "Quero conversar com uma pessoa da agência"
]


# Vetorização das novas frases
novas_frases_vectorizadas = vectorizer.transform(novas_frases)


# Realização das previsões
previsoes = modelo.predict(novas_frases_vectorizadas)


# ============================================================
# 11. EXIBIÇÃO DAS INTENÇÕES PREVISTAS
# ============================================================

print("\n" + "=" * 50)
print("PREDIÇÕES COM FRASES INÉDITAS")
print("=" * 50)

for frase, intencao in zip(novas_frases, previsoes):
    print("\nFrase:", frase)
    print("Intenção prevista:", intencao)
    print("-" * 40)

# ============================================================
# 12. FINALIZAÇÃO
# ============================================================

print("\n" + "=" * 50)
print("FIM DO DESAFIO NLU")
print("=" * 50)
